# First link the checkout as $XDG_CONFIG_HOME/quickshell/cat (see README.md).
# Merge these entries into your existing legacy Hyprland configuration.
exec-once = quickshell -c cat
exec-once = hyprpaper
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store

bind = SUPER, SPACE, exec, quickshell ipc -c cat call shell menu
bind = SUPER, R, exec, quickshell ipc -c cat call shell launcher
bind = SUPER, P, exec, quickshell ipc -c cat call shell session
bind = SUPER, V, exec, quickshell ipc -c cat call shell clipboard
bind = SUPER, N, exec, quickshell ipc -c cat call shell notifications
bind = SUPER SHIFT, N, exec, quickshell ipc -c cat call shell dnd
